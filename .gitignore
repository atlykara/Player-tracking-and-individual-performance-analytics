# Raw data and videos (large, not versioned)
data/
*.mp4
*.avi
*.mov
*.mkv

# Model weights
*.pt
*.pth

# Heavy generated outputs (folder itself is kept via .gitkeep)
outputs/*
!outputs/.gitkeep
# Small, reviewable results are versioned: per-run tracks.csv and the
# evaluation reports. Labels folders and videos stay out.
!outputs/tracking/
outputs/tracking/*/*
!outputs/tracking/*/tracks.csv
!outputs/evaluation/

# Ultralytics default run folder (relative project= paths also land here)
runs/

# Course documents kept out of the repository
SWE402_SeniorDesignProject.*

# Python environment and caches
.venv/
__pycache__/
*.pyc
