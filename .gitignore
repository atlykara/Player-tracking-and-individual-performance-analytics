# Raw data and videos (large, not versioned). `data/*` instead of `data/`
# so that the small ROI files below can be re-included.
data/*
!data/roi/
!data/roi/*
*.mp4
*.avi
*.mov
*.mkv

# Model weights
*.pt
*.pth

# Heavy generated outputs (folder itself is kept via .gitkeep)
outputs/*
!outputs/.gitkeep
# Small, reviewable results are versioned: per-run tracks.csv and the
# evaluation reports. Labels folders and videos stay out.
!outputs/tracking/
outputs/tracking/*/*
!outputs/tracking/*/tracks.csv
!outputs/tracking/*/evaluation/

# Ultralytics default run folder (relative project= paths also land here)
runs/

# Course documents kept out of the repository
SWE402_SeniorDesignProject.*

# Python environment and caches
.venv/
__pycache__/
*.pyc

# Middle frame of the current output video (small, versioned).
# The videos themselves stay out through outputs/* and *.mp4.
!outputs/118575_latest_frame.jpg

# Movement stage: movement.csv is ~8.4 MB, so it stays out; the small
# consistency report is versioned.
!outputs/movement/
outputs/movement/*/*
!outputs/movement/*/consistency_report.md
